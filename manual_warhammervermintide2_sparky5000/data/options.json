                "adds missions from the karak azgaraz DLC"
            ]
        },
        "Verminous_Dreams": {
            "type": "Toggle",
            "default": false,
            "description": [
                "adds missions from the verminous dreams DLC"
            ]
        },
        "Reikland_Tales": {
            "type": "Toggle",
            "default": false,
            "description": [
                "adds missions from the reikland tales DLC"
            ]
        },
        "Shadows_Over_Bogenhafen": {
            "type": "Toggle",
            "default": false,
            "description": [
                "adds missions from the shadows over bogenhafen DLC"
            ]
        },
        "Back_to_Ubersreik": {
            "type": "Toggle",
            "default": false,
            "description": [
