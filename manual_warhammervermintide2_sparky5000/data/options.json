{
    "core": {
        "death_link": {
            "default": false
        }
    },
    "user": {
        "Add_Tomes": {
            "type": "Toggle",
            "default": true,
            "description": [
                "adds 3 Tome locations per mission"
            ]
        },
        "Add_Grimoires": {
            "type": "Toggle",
            "default": true,
            "description": [
                "adds 2 Grimoire locations per mission"
            ]
        },
        "Careersanity":{
            "type": "Toggle",
            "default": false,
            "description": [
                "Adds location for completing missions with each career",
                "Note: the career items will be in the pool regardless of if this is enabled or not"
            ]
        },
        "DLC_Careers": {
            "type": "Toggle",
            "default": true,
            "description": [
                "Adds the 5 DLC Careers and, if enabled, their weapons to the item pool"
            ]
        },
        "Add_Weapon": {
            "type": "Toggle",
            "default": true,
            "description": [
                "adds individual weapons as items in the the item pool",
                "This adds a LOT of items, make sure you have enough locations"
            ]
        },
        "Back_To_Ubersreik_Weapons": {
            "type": "Toggle",
            "default": true,
            "description": [
                "adds Weapons from the Back to Ubersreik DLC to the item pool. does nothing if weapons are disabled"
            ]
        },
        "Winds_of_Magic_Weapons": {
            "type": "Toggle",
            "default": true,
            "description": [
                "adds Weapons from the Winds of Magic DLC to the item pool. does nothing if weapons are disabled"
            ]
        },
        "Forgotten_Relics": {
            "type": "Toggle",
            "default": true,
            "description": [
                "adds Weapons from the Forgotten Relics DLC to the item pool. does nothing if weapons are disabled"
            ]
        },
        "Chaos_Wastes": {
            "type": "Toggle",
            "default": false,
            "description": [
                "adds expeditions from the chaos wastes DLC",
