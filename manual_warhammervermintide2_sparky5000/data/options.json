        "A_Treacherous_Adventure": {
            "type": "Toggle",
            "default": false,
            "descriptions": [
                "adds missions from a treacherous adventure DLC"
            ]
        },
        "Karak_Azgaraz": {
            "type": "Toggle",
            "default": false,
